
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= title
        link(rel="stylesheet", href="/css/styles.css")

    body(class="bg-slate-950 text-white min-h-screen")
        header(class="bg-slate-900 p-6")
            h1(class="text-3xl font-bold text-green-400 text-center") Penguin Store
            p(class="text-center text-gray-300 mt-2") Todo lo que necesitas en tu iglú.

        main(class="max-w-6xl mx-auto p-6")
            h2(class="text-2xl font-bold mb-6") Nuestros productos

            if products.length === 0
                p(class="text-gray-300") No hay productos disponibles por el momento.

            else
                div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6")
                    each product in products
                        article(class="bg-white text-gray-900 rounded-xl p-5 shadow-lg")
                            if product.images && product.images.length
                                img(
                                    class="w-full h-48 object-cover rounded-lg"
                                    src=product.images[0]
                                    alt=product.name
                                )

                            h3(class="text-xl font-bold mt-3")= product.name

                            p(class="text-gray-600 mt-2")= product.description

                            p(class="text-green-700 font-bold text-xl mt-3")
                                | G. #{product.price.toLocaleString("es-PY")}

                            p(class="text-sm text-gray-500 mt-2")
                                | Stock disponible: #{product.stock}

            div(class="text-center mt-10")
                a(
                    class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg"
                    href="/store/checkout"
                ) Realizar una compra
