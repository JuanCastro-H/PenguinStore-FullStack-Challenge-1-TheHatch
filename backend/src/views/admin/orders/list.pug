doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= title
        link(rel="stylesheet", href="/css/styles.css")

    body(class="bg-slate-950 text-white min-h-screen flex flex-col")

        //- =============================================
        //- ENCABEZADO
        //- =============================================

        header(class="bg-slate-900 border-b border-slate-800 p-6")

            h1(class="text-2xl sm:text-3xl font-bold text-green-400 text-center")
                | Penguin Store 🐧

            p(class="text-center text-gray-400 text-sm mt-1")
                | Administración de pedidos

        //- =============================================
        //- CONTENIDO PRINCIPAL
        //- =============================================

        main(class="flex-1 w-full max-w-5xl mx-auto px-6 py-10")

            //- ---------------------------------------------
            //- NAVEGACIÓN E INTRODUCCIÓN
            //- ---------------------------------------------

            div(class="mb-8")

                a(
                    href="/admin"
                    class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 font-semibold rounded-md focus:outline-hidden focus-visible:ring-2 focus-visible:ring-green-400 transition-colors"
                )
                    | ← Volver al panel

                h2(class="text-3xl font-bold mt-6")
                    | Pedidos de clientes

                p(class="text-gray-300 mt-2")
                    | Consulta los pedidos y administra su estado de entrega.

            //- ---------------------------------------------
            //- MENSAJES
            //- ---------------------------------------------

            if message === "delivered"
                div(class="flex items-center gap-3 bg-green-900/60 border border-green-600 text-green-100 rounded-xl p-4 mb-6")
                    | ✓ Pedido marcado como entregado correctamente.

            if message === "not-found"
                div(class="flex items-center gap-3 bg-red-900/60 border border-red-600 text-red-100 rounded-xl p-4 mb-6")
                    | No se encontró el pedido solicitado.

            //- ---------------------------------------------
            //- LISTA DE PEDIDOS
            //- ---------------------------------------------

            if orders.length === 0

                div(class="bg-slate-900 border border-dashed border-slate-700 rounded-2xl p-12 text-center")

                    p(class="text-5xl mb-4")
                        | 📦

                    h3(class="text-xl font-bold")
                        | Todavía no hay pedidos

                    p(class="text-gray-400 mt-2")
                        | Cuando tus clientes realicen compras, aparecerán aquí.

            else

                div(class="space-y-8")

                    each order in orders

                        article(class="bg-white text-gray-900 rounded-2xl shadow-lg overflow-hidden border-t-4 " + (order.status === "pending" ? "border-yellow-400" : "border-green-600"))

                            //- ---------------------------------------------
                            //- ENCABEZADO DEL PEDIDO
                            //- ---------------------------------------------

                            header(class="bg-gray-50 border-b border-gray-200 p-5 flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center")

                                div
                                    h3(class="text-lg font-bold break-all")
                                        | Pedido ##{order._id}

                                    p(class="text-sm text-gray-500 mt-1")
                                        | #{order.createdAt.toLocaleString("es-PY")}

                                if order.status === "pending"
                                    span(class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-800 rounded-full px-4 py-2 text-sm font-bold w-fit")
                                        span(class="w-2 h-2 rounded-full bg-yellow-500")
                                        | Pendiente

                                else
                                    span(class="inline-flex items-center gap-2 bg-green-100 text-green-800 rounded-full px-4 py-2 text-sm font-bold w-fit")
                                        span(class="w-2 h-2 rounded-full bg-green-600")
                                        | Entregado

                            //- ---------------------------------------------
                            //- INFORMACIÓN DEL CLIENTE
                            //- ---------------------------------------------

                            section(class="p-5 border-b border-gray-200")

                                h4(class="text-green-700 font-bold text-lg mb-4")
                                    | Información del cliente

                                div(class="grid grid-cols-1 sm:grid-cols-2 gap-5")

                                    div
                                        p(class="text-xs uppercase tracking-wide text-gray-500 font-bold")
                                            | Nombre

                                        p(class="mt-1 font-medium")
                                            | #{order.customer.name}

                                    div
                                        p(class="text-xs uppercase tracking-wide text-gray-500 font-bold")
                                            | Correo electrónico

                                        p(class="mt-1 font-medium break-all")
                                            | #{order.customer.email}

                                    div(class="sm:col-span-2")
                                        p(class="text-xs uppercase tracking-wide text-gray-500 font-bold")
                                            | Dirección

                                        p(class="mt-1 font-medium")
                                            | #{order.customer.address}

                            //- ---------------------------------------------
                            //- PRODUCTOS
                            //- ---------------------------------------------

                            section(class="p-5 border-b border-gray-200")

                                h4(class="text-green-700 font-bold text-lg mb-4")
                                    | Productos del pedido

                                div(class="space-y-3")

                                    each item in order.items

                                        div(class="bg-gray-50 border border-gray-200 border-l-4 border-l-green-600 rounded-lg p-4")

                                            h5(class="font-bold text-gray-900")
                                                | #{item.name}

                                            div(class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-3 text-sm")

                                                div
                                                    p(class="text-gray-500")
                                                        | Cantidad

                                                    p(class="font-semibold mt-1")
                                                        | #{item.quantity}

                                                div
                                                    p(class="text-gray-500")
                                                        | Precio unitario

                                                    p(class="font-semibold mt-1")
                                                        | G. #{item.price}

                                                div(class="col-span-2 sm:col-span-1")
                                                    p(class="text-gray-500")
                                                        | Subtotal

                                                    p(class="font-bold text-green-700 mt-1")
                                                        | G. #{item.subtotal}

                            //- ---------------------------------------------
                            //- TOTAL Y ACCIONES
                            //- ---------------------------------------------

                            footer(class="bg-gray-50 p-5 flex flex-col gap-5 sm:flex-row sm:justify-between sm:items-center")

                                div
                                    p(class="text-sm text-gray-500 font-semibold")
                                        | Total del pedido

                                    p(class="text-3xl font-extrabold text-green-700 mt-1")
                                        | G. #{order.total}

                                if order.status === "pending"

                                    form(
                                        action=`/admin/orders/${order._id}/deliver`
                                        method="POST"
                                    )

                                        input(
                                            type="hidden"
                                            name="_csrf"
                                            value=csrfToken
                                        )

                                        button(
                                            type="submit"
                                            class="w-full sm:w-auto bg-green-600 hover:bg-green-700 focus:outline-hidden focus-visible:ring-4 focus-visible:ring-green-300 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                                        )
                                            | Marcar como entregado

                                else

                                    span(class="inline-flex items-center gap-2 bg-green-100 text-green-800 font-bold rounded-lg px-4 py-3")
                                        | ✓ Pedido completado

        //- =============================================
        //- PIE DE PÁGINA
        //- =============================================

        footer(class="border-t border-slate-900 text-center text-gray-500 text-sm p-6")
            | Penguin Store 🐧 — Administración
